//
// Hand-written excerpt of the guard prologue of paged_kv_index_kernel, in the form nvcc emits for
// sm_80. It is task context for the agent, not compiler output: regenerate the authoritative
// listing with `make ptx CUDA_ARCH=sm_80` (build/ptx/paged_kv_indexer.ptx) and pass it with --source.
//
.visible .entry paged_kv_index_kernel(
	.param .u64 paged_kv_index_kernel_param_0,	// block_tables
	.param .u32 paged_kv_index_kernel_param_1,	// num_reqs
	.param .u32 paged_kv_index_kernel_param_2,	// max_blocks_per_req
	.param .u32 paged_kv_index_kernel_param_3,	// num_physical_blocks
	.param .u64 paged_kv_index_kernel_param_4,	// req_ids
	.param .u64 paged_kv_index_kernel_param_5,	// token_pos
	.param .u32 paged_kv_index_kernel_param_6,	// n_queries
	.param .u64 paged_kv_index_kernel_param_7	// out_slots
)
{
	.reg .pred 	%p<8>;
	.reg .b32 	%r<16>;
	.reg .b64 	%rd<24>;

	ld.param.u64 	%rd5, [paged_kv_index_kernel_param_4];
	ld.param.u32 	%r6, [paged_kv_index_kernel_param_6];
	mov.u32 	%r7, %ctaid.x;
	mov.u32 	%r8, %ntid.x;
	mov.u32 	%r9, %tid.x;
	mul.wide.u32 	%rd9, %r7, %r8;
	cvt.u64.u32 	%rd10, %r9;
	add.s64 	%rd1, %rd9, %rd10;		// idx = %ctaid.x * %ntid.x + %tid.x
	cvt.s64.s32 	%rd11, %r6;
	setp.ge.s64 	%p1, %rd1, %rd11;		// %p1 := idx >= n_queries
	@%p1 bra 	$L__BB0_5;			// masked lanes skip every access
	cvta.to.global.u64 	%rd12, %rd5;
	shl.b64 	%rd13, %rd1, 2;			// byte offset 4 * idx
	add.s64 	%rd14, %rd12, %rd13;		// &req_ids[idx] = base + 4 * idx
	ld.global.nc.u32 	%r1, [%rd14];
	// ... token_pos load, block-table gather, slot computation, st.global.u64 to out_slots[idx]
$L__BB0_5:
	ret;
}
