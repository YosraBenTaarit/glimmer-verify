# ---------------------------------------------------------------------------
# LLM backend: "openrouter" (laptop development) or "local_server" (vLLM/SGLang)
# ---------------------------------------------------------------------------
BACKEND=openrouter

# --- BACKEND=openrouter -----------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta/muse-glimmer-30b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pin providers (comma-separated slugs). Each provider has its own prompt cache and may serve a different
# quantization, so load-balancing breaks prefix caching and mixes model variants within one run.
# meta/muse-glimmer-30b is served by deepinfra (bf16) and together at the time of writing.
OPENROUTER_PROVIDER_ORDER=deepinfra
OPENROUTER_ALLOW_FALLBACKS=true
# Optional attribution headers shown on openrouter.ai
OPENROUTER_APP_URL=https://github.com/your-org/glimmer-verify
OPENROUTER_APP_TITLE=glimmer-verify

# --- BACKEND=local_server ---------------------------------------------------
# vllm -> http://localhost:8000/v1, sglang -> http://localhost:30000/v1 (used when LOCAL_SERVER_URL is empty)
LOCAL_SERVER_KIND=vllm
LOCAL_SERVER_URL=
# Must equal the server's --served-model-name
LOCAL_MODEL=meta-models/Muse-Glimmer-30B
LOCAL_API_KEY=EMPTY
# Prometheus endpoint; empty = derived from LOCAL_SERVER_URL (".../v1" -> ".../metrics")
LOCAL_METRICS_URL=

# --- Sampling -----------------------------------------------------------------
GLIMMER_TEMPERATURE=0.2
GLIMMER_TOP_P=0.95
GLIMMER_MAX_TOKENS=4096
# OpenRouter: bound the reasoning scratchpad (it counts against GLIMMER_MAX_TOKENS). Set at most one.
# effort: minimal | low | medium | high
GLIMMER_REASONING_EFFORT=
GLIMMER_REASONING_MAX_TOKENS=
GLIMMER_SEED=
GLIMMER_REQUEST_TIMEOUT_S=600

# --- Proof-repair loop ------------------------------------------------------
MAX_RETRIES=8
LAKE_CMD=lake
LEAN_TIMEOUT_S=300

# --- Telemetry ----------------------------------------------------------------
# auto = sample the local GPU only when BACKEND=local_server
GLIMMER_NVML=auto
GLIMMER_NVML_INTERVAL_S=0.2

# ---------------------------------------------------------------------------
# Serving (scripts/launch_*.sh and docker/docker-compose.yml)
# ---------------------------------------------------------------------------
MODEL_ID=meta-models/Muse-Glimmer-30B
SERVED_MODEL_NAME=meta-models/Muse-Glimmer-30B
HF_TOKEN=
# 24 GB GPUs need a 4-bit checkpoint in MODEL_ID plus e.g. QUANTIZATION=awq
QUANTIZATION=
MAX_MODEL_LEN=32768
GPU_MEM_UTIL=0.90
TP_SIZE=1
VLLM_IMAGE_TAG=latest
SGLANG_IMAGE_TAG=latest
# Extra flags appended verbatim (single-quote values containing spaces), e.g.
#   VLLM_EXTRA_ARGS='--model-impl transformers --limit-mm-per-prompt {"image":0,"video":0}'
VLLM_EXTRA_ARGS=
SGLANG_EXTRA_ARGS=
GRAFANA_ADMIN_PASSWORD=admin
